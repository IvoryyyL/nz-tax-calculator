<% content_for :title, "Income Tax Calculator" %>

<main class="calculator">
  <header>
    <h1>2025 NZ Personal Income Tax Calculator</h1>
    <p class="subtitle">Enter your yearly income to see the tax in each bracket.</p>
  </header>

  <div class="card">
    <%= render "form", calculation: @calculation %>
    <%= render "result", result: @result if @result %>
  </div>
</main>
